# Copy this file to .env and fill in real values

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medibook
DATABASE_URL= postgresql://neondb_owner:npg_uC3eIXS4EiKD@ep-dark-mouse-ayuq9rp8-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated origins allowed to call this API.
# NOTE: any http://localhost:<port> or http://127.0.0.1:<port> origin is
# ALSO allowed automatically (see app/main.py) so Vite/Expo dev servers
# work regardless of which port they land on. Use this list for any
# additional non-localhost origins (e.g. your deployed frontend URLs).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:19006,http://localhost:8081,exp://127.0.0.1:19000
# Razorpay test credentials
# Get these from your Razorpay dashboard and keep them secret in the backend only.
RAZORPAY_KEY_ID=your_razorpay_test_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret_here
